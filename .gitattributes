# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text files
*.php text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.txt text eol=lf
.htaccess text eol=lf
.gitignore text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.heic binary
*.sqlite binary
*.sqlite3 binary
*.db binary
